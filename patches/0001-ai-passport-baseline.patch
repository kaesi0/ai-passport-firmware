+//      尽量铺满、居中留白」，不需要按板配置。
+//
+// 为什么拆成「容器 + 子图像」两个对象：容器负责用不透明浅色底盖住整个对话界面
+// （尺寸 = 面板尺寸），子图像只按源图尺寸摆放、靠 lv_image_set_scale 放大；
+// 容器不设 LV_OBJ_FLAG_OVERFLOW_VISIBLE，子对象超出容器的部分会被裁掉，
+// 于是「盖住 UI」和「放大居中」两件事互不干扰。
+// ============================================================================
+
+void LcdDisplay::DestroyFullscreenImageLocked() {
+    if (fullscreen_image_ != nullptr) {
+        // 删容器会连带删掉子对象，并触发 LV_EVENT_DELETE 回调释放 LvglImage
+        // （其析构函数负责 heap_caps_free 掉像素缓冲），所以这里只需删容器。
+        lv_obj_delete(fullscreen_image_);
+        fullscreen_image_ = nullptr;
+        fullscreen_image_src_ = nullptr;
+    }
+    fullscreen_active_ = false;
+}
+
+bool LcdDisplay::ShowFullscreenImage(std::unique_ptr<LvglImage> image, int scale) {
+    if (image == nullptr) {
+        return false;
+    }
+    const lv_img_dsc_t* dsc = image->image_dsc();
+    if (dsc == nullptr || dsc->header.w == 0 || dsc->header.h == 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: invalid image descriptor");
+        return false;
+    }
+    if (width_ <= 0 || height_ <= 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: display size unknown");
+        return false;
+    }
+    if (!setup_ui_called_) {
+        ESP_LOGW(TAG, "ShowFullscreenImage called before SetupUI()");
+    }
+
+    // scale == 0 → 自动：保持比例、尽量铺满。两个方向取小的那个，保证不裁内容。
+    if (scale <= 0) {
+        const int by_width = width_ * 256 / static_cast<int>(dsc->header.w);
+        const int by_height = height_ * 256 / static_cast<int>(dsc->header.h);
+        scale = by_width < by_height ? by_width : by_height;
+    }
+    if (scale <= 0) {
+        scale = 256;
+    }
+
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return false;
+    }
+    // 同一时刻只保留一张全屏图：先清掉旧的，避免叠层与内存泄漏。
+    DestroyFullscreenImageLocked();
+
+    lv_obj_t* layer = lv_layer_top();
+    if (layer == nullptr) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: lv_layer_top() is null");
+        return false;
+    }
+
+    lv_obj_t* container = lv_obj_create(layer);
+    lv_obj_remove_flag(container, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(container, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_pad_all(container, 0, 0);
+    lv_obj_set_style_border_width(container, 0, 0);
+    lv_obj_set_style_outline_width(container, 0, 0);
+    lv_obj_set_style_radius(container, 0, 0);
+    // 浅色底：图片比例与屏幕不一致时，留白处不会透出底下的对话界面。
+    // 不用黑色 —— 240x240 的图放到 240x320 上，黑色上下边会被看成「纯色图」。
+    lv_obj_set_style_bg_color(container, lv_color_hex(0xF4EFE6), 0);
+    lv_obj_set_style_bg_opa(container, LV_OPA_COVER, 0);
+    lv_obj_set_pos(container, 0, 0);
+    lv_obj_set_size(container, width_, height_);
+
+    lv_obj_t* src = lv_image_create(container);
+    lv_image_set_src(src, dsc);
+    lv_image_set_scale(src, scale);
+    lv_obj_center(src);
+
+    // 所有权转交 LVGL 对象：容器被删除时释放 LvglImage（进而释放像素缓冲）。
+    LvglImage* raw_image = image.release();
+    lv_obj_add_event_cb(
+        container,
+        [](lv_event_t* e) {
+            LvglImage* img = static_cast<LvglImage*>(lv_event_get_user_data(e));
+            if (img != nullptr) {
+                delete img;
+            }
+        },
+        LV_EVENT_DELETE, static_cast<void*>(raw_image));
+
+    fullscreen_image_ = container;
+    fullscreen_image_src_ = src;
+    fullscreen_active_ = true;
+    ESP_LOGI(TAG, "Fullscreen image shown: panel %dx%d, source %ldx%ld, scale %d/256", width_,
+             height_, static_cast<long>(dsc->header.w), static_cast<long>(dsc->header.h), scale);
+    return true;
+}
+
+void LcdDisplay::HideFullscreenImage() {
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return;
+    }
+    if (!fullscreen_active_ && fullscreen_image_ == nullptr) {
+        return;
+    }
+    DestroyFullscreenImageLocked();
+    ESP_LOGI(TAG, "Fullscreen image hidden");
+}
