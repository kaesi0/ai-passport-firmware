From 5c8e32860a0281fc7a1c15218b950aa729b12559 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Sat, 10 Oct 2026 14:06:29 +0800
Subject: [PATCH] fix(audio): retry the Range resume until the link comes back
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

真机（fw-24，13:54）暴露：抖动那 10 秒里**整个链路都断了**（同一时刻
`EspTcp: Failed to get host by name` / `DNS resolution failed`），所以第一次重连必然失败。
0008 只试一次就放弃 = 等于没修。

- 续传改为**时间窗内带退避重试**：窗口 60 秒、最多 20 次、每次失败等 1.5 秒
- 每次失败都打日志（含 status），放弃时也明确打出来
- 成功时打印「续传起点 / 第几次 / 距抖动开始多久」
---
 main/notify/notify_player.cc | 57 +++++++++++++++++++++++++-----------
 1 file changed, 40 insertions(+), 17 deletions(-)

diff --git a/main/notify/notify_player.cc b/main/notify/notify_player.cc
index 3ab02dd..fa69080 100644
--- a/main/notify/notify_player.cc
+++ b/main/notify/notify_player.cc
@@ -21,7 +21,12 @@ namespace {
 //       更长的中断交给下面的 Range 续传（见 README §10 第 1 条）。
 constexpr int kHttpTimeoutMs = 10000;
 // 读失败后最多从「已消费字节」处续传几次。每次重连都精确接续，不重播。
-constexpr int kMaxResumeAttempts = 5;
+// 续传重试：链路**整体**断掉时（实测同时出现 `Failed to get host by name` /
+// `DNS resolution failed`），第一次重连必然失败——只试一次等于没修。所以按**时间窗**反复重试，
+// 直到链路回来。两个上限同时生效：时间窗 60 秒、次数 20 次。
+constexpr int kResumeWindowMs = 60000;
+constexpr int kResumeRetryDelayMs = 1500;
+constexpr int kMaxResumeAttempts = 20;
 constexpr size_t kHttpReadBufferSize = 1024;
 constexpr uint32_t kNotifyTaskStackSize = 6144;
 constexpr UBaseType_t kNotifyTaskPriority = 2;
@@ -273,11 +278,18 @@ void NotifyPlayer::WorkerTask() {
                                      static_cast<unsigned>(received_bytes),
                                      static_cast<unsigned>(expected_bytes));
                         }
-                        // 先试着续传；只有 http:// 才续（本板 https 收包必然断流）。
-                        if (stream_incomplete && resume_attempts_left > 0 && consumed_bytes > 0 &&
-                            audio_url.compare(0, 7, "http://") == 0) {
+                        // 先试着续传（带退避重试）；只有 http:// 才续（本板 https 收包必然断流）。
+                        bool resumed_ok = false;
+                        int resume_attempts = 0;
+                        const int64_t stall_started_us = esp_timer_get_time();
+                        while (!resumed_ok && stream_incomplete &&
+                               resume_attempts < kMaxResumeAttempts &&
+                               (esp_timer_get_time() - stall_started_us) / 1000 < kResumeWindowMs &&
+                               consumed_bytes > 0 && !IsCancelled(playback_id) &&
+                               audio_url.compare(0, 7, "http://") == 0) {
+                            ++resume_attempts;
                             auto resumed = Board::GetInstance().GetNetwork()->CreateHttp(0);
-                            bool resumed_ok = false;
+                            int status_code = -1;
                             if (resumed) {
                                 resumed->SetTimeout(kHttpTimeoutMs);
                                 resumed->SetHeader("Accept", "audio/ogg, application/ogg");
@@ -286,27 +298,38 @@ void NotifyPlayer::WorkerTask() {
                                                    "bytes=" + std::to_string(consumed_bytes) + "-");
                                 if (auto opened = resumed->Open("GET", audio_url); opened) {
                                     auto status = resumed->GetStatusCode();
+                                    status_code = status ? *status : -1;
                                     // 必须 206。若服务端忽略 Range 回 200（整个文件），从头喂
                                     // 会让故事**从头重播**，比失败更糟，所以宁可不续。
-                                    resumed_ok = status && *status == 206;
-                                    if (!resumed_ok) {
-                                        ESP_LOGW(TAG, "Notification resume rejected: status %d",
-                                                 status ? *status : -1);
-                                    }
+                                    resumed_ok = status_code == 206;
                                 }
                             }
-                            if (resumed_ok && !IsCancelled(playback_id)) {
+                            if (resumed_ok) {
                                 http->Close();
                                 http = std::move(resumed);
-                                --resume_attempts_left;
                                 ESP_LOGW(TAG,
-                                         "Notification resumed at byte %u (attempt %d/%d, %d left)",
-                                         static_cast<unsigned>(consumed_bytes),
-                                         kMaxResumeAttempts - resume_attempts_left,
-                                         kMaxResumeAttempts, resume_attempts_left);
-                                continue;
+                                         "Notification resumed at byte %u (attempt %d, %lld ms after the stall began)",
+                                         static_cast<unsigned>(consumed_bytes), resume_attempts,
+                                         static_cast<long long>((esp_timer_get_time() -
+                                                                 stall_started_us) / 1000));
+                            } else {
+                                // 失败原因必须打出来：本板实测这里多为 DNS/建连失败（链路整体断）
+                                ESP_LOGW(TAG,
+                                         "Notification resume attempt %d failed (status %d); retry in %d ms",
+                                         resume_attempts, status_code, kResumeRetryDelayMs);
+                                vTaskDelay(pdMS_TO_TICKS(kResumeRetryDelayMs));
                             }
                         }
+                        if (resumed_ok) {
+                            continue;
+                        }
+                        if (resume_attempts > 0) {
+                            ESP_LOGE(TAG,
+                                     "Notification gave up resuming after %d attempts / %lld ms",
+                                     resume_attempts,
+                                     static_cast<long long>((esp_timer_get_time() -
+                                                             stall_started_us) / 1000));
+                        }
                         if (!stream_incomplete) {
                             success = demuxer->Finish();
                             if (!success) {
-- 
