From a3cc6b167dcf24f5eff048b851e60b7d2325bd19 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 10 Oct 2026 12:09:46 +0800
Subject: [PATCH] fix(audio): keep a story alive across link stalls (Range
 resume)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

故事播放期间这块板会出现数秒级的链路中断（日志里同时有
`Notification playback underrun` 与 `mqtt_client: No PING_RESP`），而 5 秒读超时
会直接放弃整条 HTTP 流 —— 这就是「故事放不完」的根因，与固件版本无关。

- 读超时 5s -> 10s：1~10 秒的中断在同一条连接上熬过去，不重连、不丢音频
- 读失败或服务端提前关闭时，用 `Range: bytes=<已消费字节>-` 续传（最多 5 次），
  喂同一个 OggDemuxer，因此 OpusHead/OpusTags 与解析状态都不丢
- Range 起点取 `Process()` 返回值的累加（「已接手字节」），不是「已收到字节」；
  必须 206（回 200 = 从头喂 = 故事从头重播，宁可不续）
- 新增「读停顿 >=1s」告警日志，用来实测抖动分布
---
 main/notify/notify_player.cc | 98 +++++++++++++++++++++++++++++++-----
 1 file changed, 86 insertions(+), 12 deletions(-)

diff --git a/main/notify/notify_player.cc b/main/notify/notify_player.cc
index 312bc96..3ab02dd 100644
--- a/main/notify/notify_player.cc
+++ b/main/notify/notify_player.cc
@@ -6,13 +6,22 @@
 #include <memory>
 
 #include <esp_log.h>
+#include <esp_timer.h>
+#include <string>
 
 #include "board.h"
 #include "http.h"
 #include "ogg_demuxer.h"
 
 namespace {
-constexpr int kHttpTimeoutMs = 5000;
+// 这块板在故事播放期间会出现**数秒级的链路中断**（日志里同时能看到
+// `Notification playback underrun`、`mqtt_client: No PING_RESP`、`EspUdp: ... errno=12`）。
+// 5 秒读超时会**直接放弃整集**——这就是「故事放不完」的根因，与固件版本无关。
+// 10 秒：1~10 秒的中断在**同一条连接**上熬过去，不重连、不丢音频（只静音）；
+//       更长的中断交给下面的 Range 续传（见 README §10 第 1 条）。
+constexpr int kHttpTimeoutMs = 10000;
+// 读失败后最多从「已消费字节」处续传几次。每次重连都精确接续，不重播。
+constexpr int kMaxResumeAttempts = 5;
 constexpr size_t kHttpReadBufferSize = 1024;
 constexpr uint32_t kNotifyTaskStackSize = 6144;
 constexpr UBaseType_t kNotifyTaskPriority = 2;
@@ -228,24 +237,89 @@ void NotifyPlayer::WorkerTask() {
                         media_position_ms += frame_duration_ms;
                     });
 
+                // 续传的**正确性依据**（2026-10-10 在本机用真实 ogg 文件逐字节验证过）：
+                //   · `Process()` 的返回值是「它已接手并消化掉的字节数」，Range 起点必须用它，
+                //     **不能用「已收到字节数」**——实测偏移差 100 字节就会 has_error 且 Finish 失败；
+                //   · **不能 `Reset()` demuxer**：会丢掉 OpusHead/OpusTags，之后每一包都被丢弃
+                //     （实测：重置后续传，包数停在中断处、Finish 失败）；
+                //   · 从正确的 consumed 处续传，得到的包序列与「一次读完整文件」**完全一致**。
+                // Content-Length：用来区分「正常收完」与「服务端提前关闭」——后者也是
+                // `Connection closed prematurely` 的来源，同样应该续传而不是判失败。
+                const size_t expected_bytes = http->GetBodyLength();
+                size_t received_bytes = 0;
+                size_t consumed_bytes = 0;
+                int resume_attempts_left = kMaxResumeAttempts;
                 std::array<char, kHttpReadBufferSize> buffer;
                 while (!packet_error && !IsCancelled(playback_id)) {
+                    const int64_t read_started_us = esp_timer_get_time();
                     auto size = http->Read(buffer.data(), buffer.size());
-                    if (!size) {
-                        ESP_LOGE(TAG, "Notification HTTP read failed: %s",
-                                 size.error().ToString().c_str());
-                        break;
+                    const int64_t read_ms = (esp_timer_get_time() - read_started_us) / 1000;
+                    if (read_ms >= 1000) {
+                        // 只在真卡住时打：这几行就是「链路抖动到底有多长」的实测数据
+                        ESP_LOGW(TAG, "Notification read stalled %lld ms (received %u, consumed %u)",
+                                 static_cast<long long>(read_ms),
+                                 static_cast<unsigned>(received_bytes),
+                                 static_cast<unsigned>(consumed_bytes));
                     }
-                    if (*size == 0) {
-                        success = demuxer->Finish();
-                        if (!success) {
-                            ESP_LOGE(
-                                TAG,
-                                "Notification Ogg stream ended before a complete audio stream");
+                    if (!size || *size == 0) {
+                        // 正常收完 = 已收到字节数达到 Content-Length（长度未知时不判定提前结束）。
+                        const bool stream_incomplete =
+                            !size || (expected_bytes > 0 && received_bytes < expected_bytes);
+                        if (!size) {
+                            ESP_LOGE(TAG, "Notification HTTP read failed: %s",
+                                     size.error().ToString().c_str());
+                        } else if (stream_incomplete) {
+                            ESP_LOGW(TAG, "Notification stream closed early: %u of %u bytes",
+                                     static_cast<unsigned>(received_bytes),
+                                     static_cast<unsigned>(expected_bytes));
+                        }
+                        // 先试着续传；只有 http:// 才续（本板 https 收包必然断流）。
+                        if (stream_incomplete && resume_attempts_left > 0 && consumed_bytes > 0 &&
+                            audio_url.compare(0, 7, "http://") == 0) {
+                            auto resumed = Board::GetInstance().GetNetwork()->CreateHttp(0);
+                            bool resumed_ok = false;
+                            if (resumed) {
+                                resumed->SetTimeout(kHttpTimeoutMs);
+                                resumed->SetHeader("Accept", "audio/ogg, application/ogg");
+                                resumed->SetHeader("Accept-Encoding", "identity");
+                                resumed->SetHeader("Range",
+                                                   "bytes=" + std::to_string(consumed_bytes) + "-");
+                                if (auto opened = resumed->Open("GET", audio_url); opened) {
+                                    auto status = resumed->GetStatusCode();
+                                    // 必须 206。若服务端忽略 Range 回 200（整个文件），从头喂
+                                    // 会让故事**从头重播**，比失败更糟，所以宁可不续。
+                                    resumed_ok = status && *status == 206;
+                                    if (!resumed_ok) {
+                                        ESP_LOGW(TAG, "Notification resume rejected: status %d",
+                                                 status ? *status : -1);
+                                    }
+                                }
+                            }
+                            if (resumed_ok && !IsCancelled(playback_id)) {
+                                http->Close();
+                                http = std::move(resumed);
+                                --resume_attempts_left;
+                                ESP_LOGW(TAG,
+                                         "Notification resumed at byte %u (attempt %d/%d, %d left)",
+                                         static_cast<unsigned>(consumed_bytes),
+                                         kMaxResumeAttempts - resume_attempts_left,
+                                         kMaxResumeAttempts, resume_attempts_left);
+                                continue;
+                            }
+                        }
+                        if (!stream_incomplete) {
+                            success = demuxer->Finish();
+                            if (!success) {
+                                ESP_LOGE(
+                                    TAG,
+                                    "Notification Ogg stream ended before a complete audio stream");
+                            }
                         }
                         break;
                     }
-                    demuxer->Process(reinterpret_cast<const uint8_t*>(buffer.data()), *size);
+                    received_bytes += *size;
+                    consumed_bytes += demuxer->Process(
+                        reinterpret_cast<const uint8_t*>(buffer.data()), *size);
                     if (demuxer->HasError()) {
                         packet_error = true;
                     }
-- 
