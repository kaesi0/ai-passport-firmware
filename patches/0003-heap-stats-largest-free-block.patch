From a7c8538774fdf12bdeb39b6efdb88b17d2b5ad62 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Fri, 9 Oct 2026 21:57:04 +0800
Subject: [PATCH] feat(debug): report the largest free heap block

"free sram" alone is misleading on a board without PSRAM: during the
2026-10-09 story-download failure it still read 75 KB while a single 16 KB
contiguous TLS record buffer could not be allocated, and the microphone uplink
reported errno=12 (ENOMEM) with about 36 KB free. Both are
largest-contiguous-block problems, so print that number too.
---
 main/system_info.cc | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/main/system_info.cc b/main/system_info.cc
index c4a6077..5c6cd76 100644
--- a/main/system_info.cc
+++ b/main/system_info.cc
@@ -150,7 +150,13 @@ void SystemInfo::PrintTaskList() {
 void SystemInfo::PrintHeapStats() {
     int free_sram = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
     int min_free_sram = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL);
-    ESP_LOGI(TAG, "free sram: %u minimal sram: %u", free_sram, min_free_sram);
+    // [本地补丁] 顺带打印最大空闲块。只看「还剩多少」会误导：2026-10-09 实测
+    // 故事下载失败时 free sram 还有 75 KB，却要不到一块连续的 16 KB（TLS 收包缓冲），
+    // 麦克风上行 UDP 也在堆只剩 ~36 KB 时报过 errno=12(ENOMEM)。
+    // 这两类都是「要连续块要不到」，只有 largest block 能看出碎片程度。
+    int largest_block = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
+    ESP_LOGI(TAG, "free sram: %u minimal sram: %u largest block: %u", free_sram, min_free_sram,
+             largest_block);
 }
 
 void SystemInfo::PrintPmLocks() {
