+            if (DismissImageIfVisible()) return;
             Application::GetInstance().Schedule([this]() {
                 // Opening the audio channel with the network down would only
                 // raise an error alert, so show the ordinary "connecting" hint
@@ -713,6 +755,30 @@ private:
         const int64_t now = esp_timer_get_time();
         const auto state = Application::GetInstance().GetDeviceState();
 
+        // ------------------------------------------------------------------
+        // [本地补丁 · 图片回显] 全屏图片的看护（与播放熄屏共用这一个 1 Hz 巡检）
+        //   1) 故事一开播就把图片释放掉，让音频下载拿到最大连续块
+        //      （兜底：音频工具入口已经同步释放过一次）；
+        //   2) 图片可见期间不调光不熄屏 —— 把闲置省电的计数一直清零；
+        //   3) 最长 kImageMaxVisibleSeconds 秒后自动关，恢复官方三档省电。
+        // 这段必须在下面各条 early-return 之前，否则播放态那两条分支会把它跳过。
+        // ------------------------------------------------------------------
+        if (IsImageVisible()) {
+            if (state == kDeviceStateNotifying) {
+                ESP_LOGI(TAG, "[IMG] story started: releasing the image for the audio download");
+                Application::GetInstance().Schedule([this]() { HideImageNow(); });
+            } else if (image_shown_ms_ != 0 &&
+                       (uint32_t)(now / 1000 - image_shown_ms_) >=
+                           (uint32_t)kImageMaxVisibleSeconds * 1000u) {
+                ESP_LOGI(TAG, "[IMG] auto-hide after %ds", kImageMaxVisibleSeconds);
+                Application::GetInstance().Schedule([this]() { HideImageNow(); });
+            } else {
+                // PowerSaveTimer::WakeUp() 只做 ticks_ = 0（并在已进调光档时点亮屏幕），
+                // 不碰音频/编解码器/CPU 频率 —— 用它把 60 s 调光与 360 s 软休眠一直推后。
+                WakeUpPowerSaveTimer();
+            }
+        }
+
         // 「用户又开始对话」必须**先**判，且不参与下面的状态抖动容差。
         // 唤醒词与确定键开新会话都必经 Connecting（Application::BeginWakeWordInvoke）。
         // 如果这条判断放在 playing 分支之后，就会被「允许 <=3 秒抖动」挡住：播放刚被
@@ -759,6 +825,11 @@ private:
         if (!IsPlayingAudio()) {
             return;  // 排队这一会儿播放可能已经结束了
         }
+        // [本地补丁 · 图片回显] 用户正在看图时不熄屏（方案要求：图片可见期间不熄屏）。
+        // 巡检每秒钟还会 WakeUpPowerSaveTimer()，所以 60 s 调光也不会来。
