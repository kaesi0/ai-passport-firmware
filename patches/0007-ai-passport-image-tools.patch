+    ToolResult ShowImageFromUrl(const std::string& url) {
+        if (display_ == nullptr) {
+            return std::unexpected("本设备没有可用的屏幕");
+        }
+        if (url.empty()) {
+            return std::unexpected("图片地址不能为空");
+        }
+        if (url.compare(0, 7, "http://") != 0) {
+            if (url.compare(0, 8, "https://") == 0) {
+                return std::unexpected(
+                    "图片地址必须是明文 http：本设备无 PSRAM，https 收包要 16,749 字节连续内存，"
+                    "必然中途断流");
+            }
+            return std::unexpected("图片地址必须以 http:// 开头");
+        }
+        // 先释放上一张：绝不允许「上一张还没释放就分配下一张」。
+        if (IsImageVisible()) {
+            ESP_LOGI(TAG, "[IMG] releasing the previous image before the next download");
+            HideImageNow();
+        }
+
+        auto network = Board::GetInstance().GetNetwork();
+        if (network == nullptr) {
+            return std::unexpected("设备当前没有网络");
+        }
+        auto http = network->CreateHttp(10);
+        if (http == nullptr) {
+            return std::unexpected("无法创建 HTTP 连接");
+        }
+        ESP_LOGI(TAG, "[IMG] GET %s", url.c_str());
+        if (auto opened = http->Open("GET", url); !opened) {
+            return std::unexpected("打开图片地址失败: " + opened.error().ToString());
+        }
+        auto status = http->GetStatusCode();
+        if (!status) {
+            http->Close();
+            return std::unexpected(status.error().ToString());
+        }
+        if (*status != 200) {
+            http->Close();
+            return std::unexpected("图片地址返回 " + std::to_string(*status) + "，只接受 200");
+        }
+
+        const size_t len = http->GetBodyLength();
+        const size_t largest = heap_caps_get_largest_free_block(MALLOC_CAP_8BIT);
+        ESP_LOGI(TAG, "[IMG] len=%u; heap free=%u largest=%u", (unsigned)len,
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT), (unsigned)largest);
+        if (len < 10 || len > kMaxImageBytes) {
+            http->Close();
+            return std::unexpected("图片体积异常（" + std::to_string(len) + " 字节），本设备单张上限 " +
+                                   std::to_string((unsigned)kMaxImageBytes) + " 字节");
+        }
+        if (largest < len + 2048) {
+            http->Close();
+            return std::unexpected("设备当前没有足够的连续内存放这张图：需要 " +
+                                   std::to_string(len) + " 字节连续，当前最大 " +
+                                   std::to_string(largest) + " 字节。稍后再试。");
+        }
+
+        // 一次分配，读进来的就是最终像素缓冲（有 PSRAM 的板自动先用 PSRAM）。
+        uint8_t* buf = static_cast<uint8_t*>(heap_caps_malloc_prefer(
+            len, 2, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT, MALLOC_CAP_8BIT));
+        if (buf == nullptr) {
+            http->Close();
+            ESP_LOGE(TAG, "[IMG] malloc(%u) FAILED; largest=%u", (unsigned)len, (unsigned)largest);
+            return std::unexpected("分配图片内存失败");
+        }
+        size_t total = 0;
+        while (total < len) {
+            auto read = http->Read(reinterpret_cast<char*>(buf) + total, len - total);
+            if (!read) {
+                heap_caps_free(buf);
+                http->Close();
+                return std::unexpected("下载图片失败");
+            }
+            if (*read == 0) {
+                break;
+            }
+            total += (size_t)*read;
+        }
+        http->Close();
+        if (total != len) {
+            heap_caps_free(buf);
+            ESP_LOGE(TAG, "[IMG] short read: %u/%u", (unsigned)total, (unsigned)len);
+            return std::unexpected("图片下载不完整");
+        }
+
+        const uint8_t* tail = buf + len - 10;
+        if (std::memcmp(tail, "R5G6B5", 6) != 0) {
+            heap_caps_free(buf);
+            return std::unexpected("这不是本设备认识的图片格式（尾部缺少 R5G6B5 标记）");
+        }
+        const int w = tail[6] | (tail[7] << 8);
+        const int h = tail[8] | (tail[9] << 8);
+        if (w <= 0 || h <= 0 || (size_t)w * (size_t)h * 2 + 10 != len) {
+            heap_caps_free(buf);
+            ESP_LOGE(TAG, "[IMG] bad geometry: %dx%d for %u bytes", w, h, (unsigned)len);
+            return std::unexpected("图片尺寸与数据长度不一致");
+        }
+        ESP_LOGI(TAG, "[IMG] tail header ok: R5G6B5 %dx%d, %u bytes", w, h, (unsigned)len);
+
+        auto image = std::make_unique<LvglAllocatedImage>(buf, len, w, h, w * 2,
+                                                          LV_COLOR_FORMAT_RGB565);
+        if (!image->IsValid() || !display_->ShowFullscreenImage(std::move(image))) {
+            // 失败时 image 析构会 heap_caps_free(buf)。
+            return std::unexpected("屏幕层拒绝了这张图");
+        }
+        image_shown_ms_ = (uint32_t)(esp_timer_get_time() / 1000);
+        WakeScreenForImage();   // 面板可能已被播放熄屏/软休眠关掉，点亮它（见该函数注释）
+        ESP_LOGI(TAG, "[IMG] shown; heap free=%u largest=%u",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        return std::string("图片已显示在设备屏幕上（按任意键关闭）");
+    }
+
+    ToolResult HideImageTool() {
+        if (!IsImageVisible()) {
+            return std::string("屏幕当前没有全屏图片");
+        }
+        HideImageNow();
+        return std::string("已关闭全屏图片");
+    }
