         playback_screen_off_ = true;
         ESP_LOGI(TAG, "Playing: screen off after %ds without input (audio keeps running)",
                  kPlaybackScreenOffSeconds);
@@ -776,6 +847,280 @@ private:
         GetBacklight()->RestoreBrightness();
     }
 
+    // ------------------------------------------------------------------
+    // [本地补丁 · 图片回显] 常驻全屏图片
+    //
+    // 三个工具在 InitializeTools() 里注册：show_test_pattern / show_image / hide_image。
+    // 与显示层（补丁 0006 的 ShowFullscreenImage）的分工：显示层只管「把一块已经准备好
+    // 的像素显示出来」；本段负责「把网络上的 RGB565 直链**一次 malloc** 读进最终像素
+    // 缓冲」—— 零解码、零拷贝、零第二缓冲。这是本板无 PSRAM 前提下唯一可行的数据通路，
+    // 理由与内存账见 图片回显问题修复.md §3。
+    //
+    // 与音频的三条关系（全是为「不破坏有声故事修复」而设）：
+    //   1) self.audio.play_url 一被调用就先 HideImageNow()，把连续块立刻还给下载；
+    //   2) 1 Hz 巡检看到 Notifying 再兜底释放一次；
+    //   3) 图片可见期间 EnterPlaybackScreenOff() 直接返回，不熄屏。
+    // 本段不碰 Application::PlayAudioUrl、NotifyPlayer、音频队列、编解码器与射频。
+    // ------------------------------------------------------------------
+
+    // 图片当前是否可见。任何任务都能读（显示层用的是原子标志）。
+    bool IsImageVisible() const {
+        return display_ != nullptr && display_->IsFullscreenImageVisible();
+    }
+
+    // 关闭图片并打印释放后的堆，用来证明「像素缓冲真的还回去了」。
+    // 调用方可以是主任务，也可以是 MCP 任务（显示层自己会拿 LVGL 锁）。
+    void HideImageNow() {
+        if (!IsImageVisible()) {
+            return;
+        }
+        display_->HideFullscreenImage();
+        image_shown_ms_ = 0;
+        if (display_->IsFullscreenImageVisible()) {
+            ESP_LOGW(TAG, "[IMG] hide failed (display busy)");
+            return;
+        }
+        ESP_LOGI(TAG, "[IMG] hidden; heap free=%u largest=%u",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+    }
+
+    // 按键回调（按键任务）用：图片可见就关掉它，并吃掉这次按键（本次按键不再做别的）。
+    bool DismissImageIfVisible() {
+        if (!IsImageVisible()) {
+            return false;
+        }
+        Application::GetInstance().Schedule([this]() { HideImageNow(); });
+        return true;
+    }
+
+    // [本地补丁 · 图片回显] 把「已经关掉的面板」点亮，否则图片会显示在熄屏的面板上。
+    //
+    // 为什么必须有这一步：模型在调出图工具之前通常会先说一句（`Speaking`），而 fw-18 的
+    // 播放熄屏条件是「`Speaking`/`Notifying` 且距上次按键满 5 秒」——等火山出图的十几秒里
+    // 屏幕早就熄了。此时把图显示到已熄屏的面板上，用户什么都看不到，非得按一下键才现出来
+    // （实测判据会是：日志有 `Fullscreen image shown` 但用户报「屏幕没反应」）。
+    // 软休眠同理（闲置 360 秒后屏幕/编解码器都关了）。
+    // 两个 Exit* 都是幂等的（标志为假就直接返回），所以重复调用安全。
+    void WakeScreenForImage() {
+        WakeScreenFromPlaybackBlank();
+        if (soft_sleep_active_) {
+            Application::GetInstance().Schedule([this]() { ExitSoftSleep(); });
+        }
+    }
+
+    // RGB565 写成 LVGL 原生小端两字节（低字节在前）。
+    // 不要在这里按 SPI 屏做字节交换：flush 时由 LVGL port 的 swap_bytes 统一处理，
+    // 源数据必须保持 LVGL 原生顺序（详见 0006 的补丁说明与 README §3.2）。
+    static void Put565(uint8_t* dst, uint16_t v) {
+        dst[0] = (uint8_t)(v & 0xFF);
+        dst[1] = (uint8_t)(v >> 8);
+    }
+
+    static uint16_t Rgb565(uint8_t r, uint8_t g, uint8_t b) {
+        return (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+    }
+
+    // 阶段 0 自检：本机生成色条，不联网、不依赖服务端。
+    // 判读：颜色与排列都对 → 图层 / 字节序 / 格式三者同时成立；
+    //       红蓝互换 → 通道映射；横向条纹错位 → stride；什么都没有 → 图层问题。
+    ToolResult ShowTestPattern() {
+        if (display_ == nullptr) {
+            return std::unexpected("本设备没有可用的屏幕");
+        }
+        const int w = kTestPatternWidth;
+        const int h = kTestPatternHeight;
+        const size_t bytes = (size_t)w * (size_t)h * 2;
+
+        ESP_LOGI(TAG, "[IMG] test pattern %dx%d rgb565 need=%u; heap free=%u largest=%u", w, h,
+                 (unsigned)bytes, (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+        uint8_t* raw = static_cast<uint8_t*>(heap_caps_malloc_prefer(
+            bytes, 2, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT, MALLOC_CAP_8BIT));
+        if (raw == nullptr) {
+            ESP_LOGE(TAG, "[IMG] test pattern malloc(%u) FAILED; largest=%u", (unsigned)bytes,
+                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+            return std::unexpected("内存不足，无法生成测试图案");
+        }
+        ESP_LOGI(TAG, "[IMG] malloc ok; heap free=%u largest=%u",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),
+                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT));
+
+        // 上 1/4：8 条等宽竖带 R G B W K Y C M（判红蓝互换与通道顺序）
+        // 中 1/2：R / G / B 三条横渐变（判通道映射）
+        // 下 1/4：16 级灰阶（判位深与高低位错位）
+        static const uint8_t kBarRgb[8][3] = {
+            {255, 0, 0},   {0, 255, 0},   {0, 0, 255},   {255, 255, 255},
+            {0, 0, 0},     {255, 255, 0}, {0, 255, 255}, {255, 0, 255},
+        };
+        const int bars_end = h / 4;
+        const int bands_end = h * 3 / 4;
+        for (int y = 0; y < h; ++y) {
+            for (int x = 0; x < w; ++x) {
+                uint16_t v;
+                if (y < bars_end) {
+                    int idx = x * 8 / w;
+                    if (idx > 7) {
+                        idx = 7;
+                    }
+                    v = Rgb565(kBarRgb[idx][0], kBarRgb[idx][1], kBarRgb[idx][2]);
+                } else if (y < bands_end) {
+                    const int band = (y - bars_end) * 3 / (bands_end - bars_end);
+                    const uint8_t level = (uint8_t)(w > 1 ? x * 255 / (w - 1) : 0);
+                    v = band == 0 ? Rgb565(level, 0, 0)
+                                  : (band == 1 ? Rgb565(0, level, 0) : Rgb565(0, 0, level));
+                } else {
+                    const uint8_t level = (uint8_t)((x * 16 / w) * 17);
+                    v = Rgb565(level, level, level);
+                }
+                Put565(raw + ((size_t)y * w + x) * 2, v);
+            }
+        }
+
+        auto image = std::make_unique<LvglAllocatedImage>(raw, bytes, w, h, w * 2,
+                                                          LV_COLOR_FORMAT_RGB565);
+        if (!image->IsValid() || !display_->ShowFullscreenImage(std::move(image))) {
+            // 失败时 image 仍在作用域内，析构会 heap_caps_free(raw)，不会漏。
+            return std::unexpected("屏幕层拒绝了测试图案");
+        }
+        image_shown_ms_ = (uint32_t)(esp_timer_get_time() / 1000);
