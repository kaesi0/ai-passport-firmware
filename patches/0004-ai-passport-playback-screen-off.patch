From 62a3f5bdff375a5c81b7dd2d5505ac3c7b8221e4 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Fri, 9 Oct 2026 22:27:08 +0800
Subject: [PATCH] feat(ai-passport): blank the screen during long audio
 playback

The three idle power stages (60 s dim, 360 s soft sleep, 2160 s deep sleep) are
all gated by Application::CanEnterSleepMode(), which returns false whenever the
state is not Idle. A story (Notifying) or a knowledge-base reading (Speaking,
the knowledge MCP tools return text, so the model speaks it) therefore kept the
panel lit for the whole episode.

Add a separate path that only turns the screen off - panel display-off and
sleep-in plus backlight 0 - and never touches the codec, I2S, audio queues, CPU
frequency or the radio, so playback cannot be disturbed:

- arm it after 5 s without a key press while the state is Speaking or Notifying,
  so short replies stay lit and a long reading blanks;
- a brief (<=3 s) gap in the playing state does not restart the countdown, in
  case the cloud ever ends the turn per sentence;
- light up on any key press (WakeFromIdle) and on entering Connecting, which is
  where both the wake word and the OK key start a new conversation
  (Application::BeginWakeWordInvoke always goes through it);
- deliberately do NOT light up on Speaking -> Listening: that is how a reading
  ends naturally, and the requested behaviour is to stay dark;
- clear the flag when soft sleep wakes the screen so the timer keeps working.

Long episodes are the single biggest battery cost on this 520 mAh board, so this
is where the screen-off matters most.
---
 .../folotoy/ai-passport/ai_passport_board.cc  | 164 ++++++++++++++++++
 1 file changed, 164 insertions(+)

diff --git a/main/boards/folotoy/ai-passport/ai_passport_board.cc b/main/boards/folotoy/ai-passport/ai_passport_board.cc
index 766b6be..5853f21 100644
--- a/main/boards/folotoy/ai-passport/ai_passport_board.cc
+++ b/main/boards/folotoy/ai-passport/ai_passport_board.cc
@@ -95,6 +95,34 @@ static constexpr int kStandbyCpuMinFreq = 40;
 // wake configuration cannot leave the device asleep until the battery dies.
 static constexpr uint64_t kFallbackWakeupUs = 60ULL * 60ULL * 1000000ULL;
 
+// ============================================================================
+// [本地补丁] 长音频播放时熄屏（省电），按键或重新对话时点亮。
+//
+// 为什么必须单独做一条路径：上面那三档闲置省电（60 s 调光 / 360 s 软休眠 /
+// 2160 s 深睡）**全部**以 Application::CanEnterSleepMode() 为门，而它在
+// state != Idle 时一律返回 false。也就是说故事播放（Notifying）和知识库朗读
+// （Speaking）期间屏幕会一直亮着，一集几分钟就是白白烧电——这正是本补丁要解决的。
+//
+// 这条路径**只关屏幕**：面板 display-off + sleep-in，背光归 0。它不碰音频、
+// 编解码器、I2S、CPU 频率和射频，所以播放不会因此中断或掉帧。
+//
+// 触发条件：state 处于 Speaking / Notifying，且距上次按键（或播放开始）已过
+// kPlaybackScreenOffSeconds 秒。用「距上次按键」而不是「播放一开始就关」，是为了：
+//   - 短回复（几秒）根本不会熄屏，只在长朗读时才熄；
+//   - 播放中按过键之后，屏幕会再亮这么久，给用户留出看清屏幕的时间。
+// 点亮条件：
+//   - 按下任意键（音量 +/-、确定）—— 走 WakeFromIdle；
+//   - 状态进入 Connecting —— 唤醒词和确定键开新会话都必经这里
+//     （Application::BeginWakeWordInvoke 里明确 SetDeviceState(kDeviceStateConnecting)），
+//     所以它精确地代表「用户又开始对话了」。
+// 刻意**不**在 Speaking -> Listening 时点亮：朗读自然结束走的就是这条路，而用户要的是
+// 「播放结束保持黑屏」。代价是「朗读中用唤醒词打断」这一种情形屏幕不亮（按键仍可点亮），
+// 因为它在状态上无法与自然结束区分。
+// 播放自然结束（回到 Idle/Listening）时保持熄灭，等按键或下一次对话再亮，这样最省电；
+// 之后 360 s 的软休眠/2160 s 的深睡仍按原逻辑接管。
+// ============================================================================
+static constexpr int kPlaybackScreenOffSeconds = 5;
+
 // ============================================================================
 // ES8311 suspend, aligned register-for-register with the FoloToy AI Passport
 // BSP (components/bsp/src/bsp_audio.c). The codec-dev disable path this board
@@ -250,6 +278,15 @@ private:
     // that lands in that window.
     int64_t last_key_us_ = 0;
 
+    // [本地补丁] 播放熄屏：屏幕当前是否由这条路径关着、播放开始时刻、
+    // 以及 1 Hz 的状态轮询定时器。全部只在主任务上读写（tick 只做判断，
+    // 真正动屏幕/背光的动作都 Schedule 到主任务），详见文件顶部那段说明。
+    bool playback_screen_off_ = false;
+    bool was_playing_ = false;
+    int64_t playback_started_us_ = 0;
+    int64_t last_playing_us_ = 0;
+    esp_timer_handle_t playback_screen_timer_ = nullptr;
+
     // Guards the stage transitions against a key press that arrived while they
     // were queued: PowerSaveTimer has already forgiven that press, but the wake
     // handler scheduled behind them has not run yet.
@@ -468,6 +505,8 @@ private:
                     ArmWakeKeyGuard();
                 }
                 WakeUpPowerSaveTimer();
+                // [本地补丁] 播放熄屏与 PowerSaveTimer 无关，得自己点亮（见该函数注释）。
+                WakeScreenFromPlaybackBlank();
             });
             // Not released on press-up: the click that belongs to the wake press is
             // graded a tick after it, so the guard has to outlive the release and
@@ -560,6 +599,21 @@ private:
         }
     }
 
+    // [本地补丁] 按键点亮「播放熄屏」的屏幕。
+    //
+    // 为什么必须单独挂一次，而不是复用 WakeFromIdle()：PowerSaveTimer::WakeUp()
+    // 只在它自己 in_sleep_mode_ 为真时才回调 on_exit_sleep_mode_（→ WakeFromIdle），
+    // 而 in_sleep_mode_ 只在它的「调光档」触发时才置位；调光档在
+    // !Application::CanEnterSleepMode() 时会 `ticks_ = 0; return;`，播放态恰恰
+    // 一直是 false。所以播放期间按键根本走不到 WakeFromIdle —— fw-17 实测的现象
+    // 就是「音量键有反应、屏幕不亮」。这里直接挂在按下事件上，与状态无关。
+    void WakeScreenFromPlaybackBlank() {
+        if (!playback_screen_off_) {
+            return;
+        }
+        Application::GetInstance().Schedule([this]() { ExitPlaybackScreenOff(); });
+    }
+
     // Pin holds are latched in the RTC domain and survive the deep-sleep reset
     // (see gpio_hold_en: the state is retained when the GPIO's power domain
     // goes off, including Deep-sleep events). Every hold taken before sleeping
@@ -624,6 +678,104 @@ private:
         power_save_timer_->SetEnabled(true);
     }
 
+    // ------------------------------------------------------------------
+    // [本地补丁] 长音频播放时熄屏，按键或重新开始对话时点亮。
+    // 详细理由见文件顶部 kPlaybackScreenOffSeconds 那段注释。
+    // ------------------------------------------------------------------
+    void InitializePlaybackScreenTimer() {
+        esp_timer_create_args_t args = {};
+        args.callback = [](void* arg) {
+            static_cast<AiPassportBoard*>(arg)->OnPlaybackScreenTick();
+        };
+        args.arg = this;
+        args.name = "playback_screen";
+        esp_err_t err = esp_timer_create(&args, &playback_screen_timer_);
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "Playback screen timer create failed: %s", esp_err_to_name(err));
+            playback_screen_timer_ = nullptr;
+            return;
+        }
+        // 1 Hz：和 PowerSaveTimer 同频，判断足够细，开销可忽略。
+        esp_timer_start_periodic(playback_screen_timer_, 1000 * 1000);
+    }
+
+    // 播放态：Speaking = 云端 TTS（含 knowledge MCP 念知识库），Notifying = 有声故事。
+    bool IsPlayingAudio() const {
+        const auto state = Application::GetInstance().GetDeviceState();
+        return state == kDeviceStateSpeaking || state == kDeviceStateNotifying;
+    }
+
+    // 跑在 esp_timer 任务上，只做判断；真正动面板/背光的一律 Schedule 到主任务。
+    void OnPlaybackScreenTick() {
+        if (playback_screen_timer_ == nullptr) {
+            return;
+        }
+        const int64_t now = esp_timer_get_time();
+        const auto state = Application::GetInstance().GetDeviceState();
+
+        // 「用户又开始对话」必须**先**判，且不参与下面的状态抖动容差。
+        // 唤醒词与确定键开新会话都必经 Connecting（Application::BeginWakeWordInvoke）。
+        // 如果这条判断放在 playing 分支之后，就会被「允许 <=3 秒抖动」挡住：播放刚被
+        // 打断的那几秒里 playing 仍为真，函数直接 return，屏幕不会亮（review 发现）。
+        if (playback_screen_off_ && state == kDeviceStateConnecting) {
+            ESP_LOGI(TAG, "Playback screen off: user started a new conversation, waking screen");
+            Application::GetInstance().Schedule([this]() { ExitPlaybackScreenOff(); });
+            return;
+        }
+
+        const bool state_playing =
+            state == kDeviceStateSpeaking || state == kDeviceStateNotifying;
+        if (state_playing) {
+            last_playing_us_ = now;
+        }
+        // 连续播放才算「一段播放」，允许 <=3 秒的状态抖动：既避免几秒的短问答被熄屏，
+        // 也避免云端若按句发 tts stop/start 时反复重置计时、导致长朗读永远不熄屏。
+        const bool playing =
+            state_playing || (last_playing_us_ != 0 && now - last_playing_us_ <= 3LL * 1000000);
+        if (playing && !was_playing_) {
+            playback_started_us_ = now;
+        }
+        was_playing_ = playing;
+
+        if (playing) {
+            // 播放态：距上次按键（或本次播放开始）够久就熄屏。用「距上次按键」
+            // 而不是「播放一开始就关」有两个好处——几秒的短问答不会熄屏；
+            // 播放中按过键之后屏幕会再亮满 kPlaybackScreenOffSeconds 秒。
+            if (!playback_screen_off_) {
+                const int64_t base =
+                    playback_started_us_ > last_key_us_ ? playback_started_us_ : last_key_us_;
+                if (now - base >= (int64_t)kPlaybackScreenOffSeconds * 1000000) {
+                    Application::GetInstance().Schedule([this]() { EnterPlaybackScreenOff(); });
+                }
+            }
+            return;
+        }
+    }
+
+    void EnterPlaybackScreenOff() {
+        if (playback_screen_off_ || soft_sleep_active_ || deep_sleep_started_) {
+            return;
+        }
+        if (!IsPlayingAudio()) {
+            return;  // 排队这一会儿播放可能已经结束了
+        }
+        playback_screen_off_ = true;
+        ESP_LOGI(TAG, "Playing: screen off after %ds without input (audio keeps running)",
+                 kPlaybackScreenOffSeconds);
+        SleepPanel();
+        GetBacklight()->SetBrightness(0);
+    }
+
+    void ExitPlaybackScreenOff() {
+        if (!playback_screen_off_) {
+            return;
+        }
+        playback_screen_off_ = false;
+        ESP_LOGI(TAG, "Playing: screen back on");
+        WakePanel();
+        GetBacklight()->RestoreBrightness();
+    }
+
     // PowerSaveTimer::WakeUp() fires on every key press-down. It only invokes the
     // exit callback while it is in its sleep stage, which is exactly from the dim
     // deadline on, so this one path serves both stages.
@@ -632,6 +784,12 @@ private:
             ExitSoftSleep();
             return;
         }
+        if (playback_screen_off_) {
+            // [本地补丁] 播放中按下任意键：点亮屏幕。下一次 tick 会重新开始
+            // 计时，所以屏幕会亮满 kPlaybackScreenOffSeconds 秒再熄。
+            ExitPlaybackScreenOff();
+            return;
+        }
         GetBacklight()->RestoreBrightness();
     }
 
@@ -692,6 +850,10 @@ private:
         soft_sleep_ticks_ = 0;
         ESP_LOGI(TAG, "Input: waking from soft sleep");
 
+        // [本地补丁] 软休眠醒来时屏幕一律点亮，所以要清掉播放熄屏的标记，
+        // 否则它会一直是 true，之后就再也熄不了屏（见 WakeFromIdle 的分支顺序）。
+        playback_screen_off_ = false;
+
         WakePanel();
         GetBacklight()->RestoreBrightness();
 
@@ -1036,6 +1198,8 @@ public:
         InitializeTools();
         GetBacklight()->RestoreBrightness();
         InitializePowerSaveTimer();
+        // [本地补丁] 长音频播放期间的熄屏路径，独立于上面三档闲置省电。
+        InitializePlaybackScreenTimer();
     }
 
     // -----------------------------------------------------------------------
