From 0b7b991dc9904ab3899947793e9d24a68ed5df31 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Fri, 9 Oct 2026 10:39:43 +0800
Subject: [PATCH] fix(notify): enlarge playback task stack for long HTTPS audio

The notification downloader used a 6KB task and a 5s read timeout.
Long audiobook streams could overflow that task or stall a read, which
stops playback and can reboot the device.
---
 main/notify/notify_player.cc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/main/notify/notify_player.cc b/main/notify/notify_player.cc
index 312bc96..8a9f562 100644
--- a/main/notify/notify_player.cc
+++ b/main/notify/notify_player.cc
@@ -12,9 +12,10 @@
 #include "ogg_demuxer.h"
 
 namespace {
-constexpr int kHttpTimeoutMs = 5000;
+constexpr int kHttpTimeoutMs = 20000;
 constexpr size_t kHttpReadBufferSize = 1024;
-constexpr uint32_t kNotifyTaskStackSize = 6144;
+// HTTPS needs more than 6KB. A stack overflow here stops playback and reboots.
+constexpr uint32_t kNotifyTaskStackSize = 20480;
 constexpr UBaseType_t kNotifyTaskPriority = 2;
 const char* TAG = "NotifyPlayer";
 
