             Application::GetInstance().Schedule([this]() { ChangeVolume(-10); });
         });
         down->OnLongPress([this]() {
@@ -442,6 +450,8 @@ private:
         auto ok = adc_button_[kAdcButtonOk];
         ok->OnClick([this]() {
             if (KeyEventsBlocked()) return;
+            // [本地补丁] 同上：先关全屏图片，不要直接进对话。
+            if (DismissFullscreenImage()) return;
             Application::GetInstance().Schedule([this]() {
                 // Opening the audio channel with the network down would only
                 // raise an error alert, so show the ordinary "connecting" hint
@@ -1053,6 +1063,250 @@ public:
     // 采样率必须对齐本板 AUDIO_OUTPUT_SAMPLE_RATE（本板 24000），
     // 否则 OpusHead 里写的是别的速率，固件需要额外重采样，听感会变慢或变快。
     // -----------------------------------------------------------------------
+    // -----------------------------------------------------------------------
+    // [本地补丁] 若全屏图片正在显示，就关掉它并返回 true。
+    //
+    // 按键回调跑在按键任务上，而 LVGL 只能在主任务里动，因此这里只做一次
+    // 无锁的可见性判断，真正的隐藏交给 Application::Schedule 回主任务执行
+    // （与本文件其它按键处理完全一致）。
+    // -----------------------------------------------------------------------
+    bool DismissFullscreenImage() {
+        if (display_ == nullptr || !display_->IsFullscreenImageVisible()) {
+            return false;
+        }
+        Application::GetInstance().Schedule([this]() { display_->HideFullscreenImage(); });
+        return true;
+    }
+
+    // -----------------------------------------------------------------------
+    // [本地补丁] 下载并全屏显示一张网络图片
+    //
+    // 和内建的 self.screen.preview_image 相比，两处关键差别决定了必须自建：
+    //   1) 那个工具是 AddUserOnlyTool，模型在 tools/list 里看不到，于是典型症状是
+    //      "模型念得出图片网址、屏幕却没反应"；本工具用 AddTool 注册，模型可见。
+    //   2) 它显示 5 秒后自动消失，且只占屏幕约一半；本板全屏常驻，直到显式隐藏。
+    //
+    // 解码分两级：先交给 LVGL 解码器（本固件只启用了 PNG），不行再用固件自带的
+    // jpeg_to_image()（esp_new_jpeg，输出 RGB565）兜底。第二级不是可选优化——
+    // 本固件的 LVGL 没开 JPEG 解码器（sdkconfig 里只有 CONFIG_LV_USE_LODEPNG=y，
+    // LV_USE_TJPGD / LV_USE_SJPG 均未启用），而多数生图服务默认返回 JPEG。
+    //
+    // 内存红线（本板 ESP32-C3，8MB Flash，**无 PSRAM**）：
+    //   - 下载缓冲上限 128KB。别的板子（如带 PSRAM 的 S3）敢放到 1MB，这里不行；
+    //   - 解码后像素量上限 120KB（≈240x256 RGB565）。屏是 240x320，满屏 RGB565
+    //     要 150KB，已经吃掉了本板通常可用的整块堆，所以刻意压在 120KB。
+    //   超限一律明确报错，而不是硬撑到 OOM——设备是真的显示不了。
+    // -----------------------------------------------------------------------
+    // -----------------------------------------------------------------------
+    // [本地补丁] 只从 JPEG 字节流里读出宽高，不解码。
+    //
+    // 存在的理由：jpeg_to_image() 是**整幅解码**——它一次性分配 宽×高×2 字节的
+    // RGB565 缓冲（jpeg_to_image.h:20-23），没有流式选项。本板没有 PSRAM，一张
+    // 超限图会在它返回之前就把堆撑爆，我们连"优雅地拒绝"都做不到，只会 OOM。
+    // 所以要先扫 SOF marker 拿到尺寸，超限直接返回错误。
+    //
+    // JPEG 结构：SOI(FFD8) 之后是一串 FFxx + 长度(2B,大端) 的段；SOF0/1/2
+    // （FFC0~FFCF，排除定义 Huffman 表/算术编码的 C4/C8/CC）里紧跟着
+    // 精度(1B)、高度(2B)、宽度(2B)。
+    // -----------------------------------------------------------------------
+    static bool GetJpegSize(const uint8_t* data, size_t len, int* width, int* height) {
+        if (data == nullptr || len < 4 || data[0] != 0xFF || data[1] != 0xD8) {
+            return false;  // 不是 JPEG（或太短）
+        }
+        size_t p = 2;
+        while (p + 3 < len) {
+            if (data[p] != 0xFF) {  // 填充字节，跳过
+                ++p;
+                continue;
+            }
+            const uint8_t marker = data[p + 1];
+            if (marker == 0xFF) {  // 连续 FF 是填充，前进一格重试
+                ++p;
+                continue;
+            }
+            if (marker == 0xD8 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7)) {
+                p += 2;  // 无长度字段的独立标记
+                continue;
+            }
+            if (marker == 0xD9) {  // EOI：走到结尾也没见到 SOF
+                return false;
+            }
+            const size_t seg_len = (static_cast<size_t>(data[p + 2]) << 8) | data[p + 3];
+            const bool is_sof = (marker >= 0xC0 && marker <= 0xCF) && marker != 0xC4 &&
+                                marker != 0xC8 && marker != 0xCC;
+            if (is_sof) {
+                if (p + 9 >= len) {
+                    return false;
+                }
+                *height = (static_cast<int>(data[p + 5]) << 8) | data[p + 6];
+                *width = (static_cast<int>(data[p + 7]) << 8) | data[p + 8];
+                return *width > 0 && *height > 0;
+            }
+            if (seg_len == 0) {
+                return false;  // 长度为 0 会死循环
+            }
+            p += 2 + seg_len;
+        }
+        return false;
+    }
+
+    ToolResult ShowImageFromRaw(const std::string& encoded) {
+        if (display_ == nullptr) {
+            return std::unexpected("本设备没有可用的屏幕");
+        }
+        display_->HideFullscreenImage();
+        std::string bytes;
+        bytes.resize((encoded.size() * 3) / 4 + 4);
+        size_t out_len = 0;
+        if (mbedtls_base64_decode(reinterpret_cast<unsigned char*>(bytes.data()), bytes.size(),
+                                  &out_len, reinterpret_cast<const unsigned char*>(encoded.data()),
+                                  encoded.size()) != 0 || out_len < 12) {
+            return std::unexpected("图片数据无法解码");
+        }
+        if (std::memcmp(bytes.data(), "R5G6B5", 6) != 0) {
+            return std::unexpected("不是设备像素格式");
+        }
+        const auto* hdr = reinterpret_cast<const uint8_t*>(bytes.data());
+        const int w = hdr[6] | (hdr[7] << 8);
+        const int h = hdr[8] | (hdr[9] << 8);
+        const size_t pixels = static_cast<size_t>(w) * h * 2;
+        if (w <= 0 || h <= 0 || w > 240 || h > 240 || out_len < 10 + pixels) {
+            return std::unexpected("图片尺寸不正确");
+        }
+        auto* raw = static_cast<uint8_t*>(heap_caps_malloc(pixels, MALLOC_CAP_8BIT));
+        if (raw == nullptr) {
+            return std::unexpected("Out of memory for image pixels");
+        }
+        std::memcpy(raw, hdr + 10, pixels);
+        auto image = std::make_unique<LvglAllocatedImage>(
+            raw, pixels, w, h, w * 2, LV_COLOR_FORMAT_RGB565);
+        if (!display_->ShowFullscreenImage(std::move(image))) {
+            return std::unexpected("Display does not support fullscreen image");
+        }
+        return std::string("图片已全屏显示在设备屏幕上");
+    }
+
+    ToolResult ShowImageFromUrl(const std::string& url) {
+        if (url.empty()) {
+            return std::unexpected("url 不能为空");
+        }
+        if (display_ == nullptr) {
+            return std::unexpected("本设备没有可用的屏幕");
+        }
+        // 先释放上一张图，再下载新图。否则旧图、下载缓冲、解码缓冲会同时存在，
+        // 第二次显示就会报内存不足。
+        display_->HideFullscreenImage();
+
+        // 官方 preview_image 用的是 3 秒超时，公网图片（尤其首次 TLS 握手）常常不够，
+        // 这里放宽到 15 秒。
+        auto http = Board::GetInstance().GetNetwork()->CreateHttp(15);
+        if (http == nullptr) {
+            return std::unexpected("Failed to create HTTP client");
+        }
+        if (auto opened = http->Open("GET", url); !opened) {
+            return std::unexpected("Failed to open URL: " + url + " (" +
+                                   opened.error().ToString() + ")");
+        }
+        auto status_code = http->GetStatusCode();
+        if (!status_code) {
+            http->Close();
+            return std::unexpected(status_code.error().ToString());
+        }
+        if (*status_code != 200) {
+            http->Close();
+            return std::unexpected("Unexpected status code: " + std::to_string(*status_code));
+        }
+
+        const size_t content_length = http->GetBodyLength();
+        constexpr size_t kMaxDownloadBytes = 128 * 1024;
+        if (content_length == 0 || content_length > kMaxDownloadBytes) {
+            http->Close();
+            return std::unexpected("Image size not acceptable: " +
+                                   std::to_string(content_length) +
+                                   " bytes (must be 1..131072)");
+        }
+
+        using BufferPtr = std::unique_ptr<char, decltype(&heap_caps_free)>;
+        BufferPtr data(
+            static_cast<char*>(heap_caps_malloc(content_length, MALLOC_CAP_8BIT)),
+            heap_caps_free);
+        if (data == nullptr) {
+            http->Close();
+            return std::unexpected("Out of memory for image download");
+        }
+        size_t total_read = 0;
+        while (total_read < content_length) {
+            auto ret = http->Read(data.get() + total_read, content_length - total_read);
+            if (!ret) {
+                http->Close();
+                return std::unexpected("Failed to download image");
+            }
+            if (*ret == 0) {
+                break;
+            }
+            total_read += *ret;
+        }
+        http->Close();
+
+        constexpr size_t kMaxDecodedBytes = 120 * 1024;
+        // 服务端直接下发的像素图：12 字节头 + RGB565。设备不再解码。
+        // 头：R5G6B5(6) + width/height 小端(4) + 像素。像素已按本 SPI 屏的
+        // swap_bytes 排好，LVGL 直接显示。
+        if (total_read >= 12 && std::memcmp(data.get(), "R5G6B5", 6) == 0) {
+            const auto* hdr = reinterpret_cast<const uint8_t*>(data.get());
+            const int w = hdr[6] | (hdr[7] << 8);
+            const int h = hdr[8] | (hdr[9] << 8);
+            const size_t pixels = static_cast<size_t>(w) * h * 2;
+            if (w <= 0 || h <= 0 || pixels > kMaxDecodedBytes || total_read < 10 + pixels) {
+                return std::unexpected("Invalid raw RGB565 image");
+            }
+            auto* raw = static_cast<uint8_t*>(heap_caps_malloc(pixels, MALLOC_CAP_8BIT));
+            if (raw == nullptr) {
+                return std::unexpected("Out of memory for image pixels");
+            }
+            std::memcpy(raw, hdr + 10, pixels);
+            data.reset();
+            image = std::make_unique<LvglAllocatedImage>(
+                raw, pixels, w, h, w * 2, LV_COLOR_FORMAT_RGB565);
+            decoder_used = "rgb565";
+        }
+
+        if (image != nullptr) {
+            if (!display_->ShowFullscreenImage(std::move(image))) {
+                return std::unexpected("Display does not support fullscreen image");
+            }
+            return std::string("图片已全屏显示在设备屏幕上");
+        }
+
+        // IsValid() 只在 LvglAllocatedImage 上，不在基类 LvglImage。
+        // ShowFullscreenImage 吃的是 unique_ptr<LvglImage>，这里靠移动转换。
+        std::unique_ptr<LvglAllocatedImage> image;
+        const char* decoder_used = "none";
+
+        // ---- 第一级：LVGL 解码器（本固件为 PNG）----
+        {
+            lv_image_dsc_t probe = {};
+            probe.data_size = total_read;
+            probe.data = reinterpret_cast<uint8_t*>(data.get());
+            // magic 必须显式设成 LV_IMAGE_HEADER_MAGIC：LVGL 靠它区分「这是一块
+            // lv_image_dsc_t」还是「这是一个文件路径字符串」（lv_image_src_get_type）。
+            // 不设的话 magic=0，判定结果就取决于 LVGL 内部实现，等于把自己的命运
+            // 交给别人；一旦被当成文件路径处理，PNG 会误落到下面的 JPEG 分支彻底失败。
+            probe.header.magic = LV_IMAGE_HEADER_MAGIC;
+            lv_image_header_t header = {};
+            if (lv_image_decoder_get_info(&probe, &header) == LV_RESULT_OK) {
+                if (header.w == 0 || header.h == 0) {
+                    return std::unexpected("Downloaded image is invalid (bad header)");
+                }
+                const size_t decoded = static_cast<size_t>(header.w) * header.h * 2;
+                if (decoded > kMaxDecodedBytes) {
+                    return std::unexpected("Image too large for this device: " +
+                                           std::to_string(header.w) + "x" +
+                                           std::to_string(header.h) +
+                                           " (max about 240x256, this board has no PSRAM)");
+                }
+                image = std::make_unique<LvglAllocatedImage>(data.release(), total_read);
+                // IsValid() 是官方 preview_image 的做法（mcp_server.cc:307）：
+                // 构造只填 dsc、不判内容，合法性必须自己查。缺了它，坏图会一路走
+                // 到 ShowFullscreenImage 才被拒，返回的错误还误导成「屏幕不支持」。
+                if (!image->IsValid()) {
+                    return std::unexpected("Downloaded image is invalid: " + url);
+                }
+                decoder_used = "lvgl";
+            }
+        }
+
+        // ---- 第二级：固件自带的 JPEG 解码器（输出 RGB565）----
+        if (image == nullptr) {
+            // 尺寸必须**在解码之前**拦下一道。jpeg_to_image() 会一次性申请
+            // 宽×高×2 的整幅缓冲，本板没有 PSRAM，等它把内存申请完再拒绝，
+            // 就已经晚了（结果多半不是这段错误句子，而是直接 OOM）。
+            int pre_w = 0;
+            int pre_h = 0;
+            if (GetJpegSize(reinterpret_cast<const uint8_t*>(data.get()), total_read,
+                            &pre_w, &pre_h)) {
+                const size_t would_be = static_cast<size_t>(pre_w) * pre_h * 2;
+                if (would_be > kMaxDecodedBytes) {
+                    return std::unexpected("Image too large for this device: " +
+                                           std::to_string(pre_w) + "x" +
+                                           std::to_string(pre_h) +
+                                           " (max about 240x256, this board has no PSRAM)");
+                }
+            }
+            // 读不出尺寸（渐进式 JPEG 或数据损坏）时不拦，交给解码器去判——
+            // 乱拦会把本来能显示的图误报成「太大」。
+
+            uint8_t* rgb = nullptr;
+            size_t rgb_len = 0;
+            size_t jw = 0;
+            size_t jh = 0;
+            size_t stride = 0;
+            const esp_err_t jerr = jpeg_to_image(reinterpret_cast<const uint8_t*>(data.get()),
+                                                 total_read, &rgb, &rgb_len, &jw, &jh, &stride);
+            if (jerr != ESP_OK || rgb == nullptr) {
+                return std::unexpected("Unsupported or undecodable image "
+                                       "(this firmware can decode PNG and JPEG only)");
+            }
+            // 解码后按实际 stride 再核一遍：硬件解码器会把边长对齐到 16 字节，
+            // 实际缓冲可能比 宽×高×2 更大（jpeg_to_image.h:49-52）。
+            if (jw == 0 || jh == 0 || rgb_len > kMaxDecodedBytes) {
+                heap_caps_free(rgb);
+                return std::unexpected("Image too large for this device: " + std::to_string(jw) +
+                                       "x" + std::to_string(jh) + ", but buffer is " +
+                                       std::to_string(rgb_len) +
+                                       " bytes (max 122880, this board has no PSRAM)");
+            }
+            data.reset();  // 压缩数据已无用，解码结果另占一块内存
+            // SPI 屏的 LVGL 打开了 swap_bytes。esp_new_jpeg 输出的是小端 RGB565，
+            // 不交换时 LVGL 会按大端解释，红苹果会变成整屏纯色。
+            auto* pixels = reinterpret_cast<uint16_t*>(rgb);
+            const size_t pixel_count = rgb_len / 2;
+            for (size_t i = 0; i < pixel_count; ++i) {
