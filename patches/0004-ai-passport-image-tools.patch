From 41ace7ef2b413c1968665db8cb5c5366edf0a7b7 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Fri, 9 Oct 2026 09:39:39 +0800
Subject: [PATCH] feat(ai-passport): show raw RGB565 from
 self.screen.show_image

data carries base64 RGB565 pixels, so the device no longer downloads or
decodes PNG/JPEG. Any key hides the current image before the next one.
---
 .../folotoy/ai-passport/ai_passport_board.cc  | 84 +++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/main/boards/folotoy/ai-passport/ai_passport_board.cc b/main/boards/folotoy/ai-passport/ai_passport_board.cc
index 766b6be..0ea43d3 100644
--- a/main/boards/folotoy/ai-passport/ai_passport_board.cc
+++ b/main/boards/folotoy/ai-passport/ai_passport_board.cc
@@ -5,6 +5,10 @@
 #include "button.h"
 #include "config.h"
 #include "mcp_server.h"
+#include "lvgl_display/lvgl_image.h"
+#include "jpg/jpeg_to_image.h"
+#include <esp_heap_caps.h>
+#include <mbedtls/base64.h>
 #include "assets/lang_config.h"
 #include "cw2017_battery_monitor.h"
 #include "power_save_timer.h"
@@ -416,6 +420,7 @@ private:
         auto up = adc_button_[kAdcButtonUp];
         up->OnClick([this]() {
             if (KeyEventsBlocked()) return;
+            if (DismissImageIfVisible()) return;
             Application::GetInstance().Schedule([this]() { ChangeVolume(10); });
         });
         up->OnLongPress([this]() {
@@ -429,6 +434,7 @@ private:
         auto down = adc_button_[kAdcButtonDown];
         down->OnClick([this]() {
             if (KeyEventsBlocked()) return;
+            if (DismissImageIfVisible()) return;
             Application::GetInstance().Schedule([this]() { ChangeVolume(-10); });
         });
         down->OnLongPress([this]() {
@@ -442,6 +448,7 @@ private:
         auto ok = adc_button_[kAdcButtonOk];
         ok->OnClick([this]() {
             if (KeyEventsBlocked()) return;
+            if (DismissImageIfVisible()) return;
             Application::GetInstance().Schedule([this]() {
                 // Opening the audio channel with the network down would only
                 // raise an error alert, so show the ordinary "connecting" hint
@@ -1053,6 +1060,57 @@ public:
     // 采样率必须对齐本板 AUDIO_OUTPUT_SAMPLE_RATE（本板 24000），
     // 否则 OpusHead 里写的是别的速率，固件需要额外重采样，听感会变慢或变快。
     // -----------------------------------------------------------------------
+    bool DismissImageIfVisible() {
+        if (display_ == nullptr || !display_->IsFullscreenImageVisible()) {
+            return false;
+        }
+        Application::GetInstance().Schedule([this]() {
+            if (display_ != nullptr) {
+                display_->HideFullscreenImage();
+            }
+        });
+        return true;
+    }
+
+    ToolResult ShowRawImage(const uint8_t* bytes, size_t size) {
+        if (size < 10 || std::memcmp(bytes, "R5G6B5", 6) != 0) {
+            return std::unexpected("不是设备像素格式");
+        }
+        const int w = bytes[6] | (bytes[7] << 8);
+        const int h = bytes[8] | (bytes[9] << 8);
+        const size_t pixels = static_cast<size_t>(w) * h * 2;
+        if (w <= 0 || h <= 0 || w > 240 || h > 240 || size < 10 + pixels ||
+            pixels > 120 * 1024) {
+            return std::unexpected("图片尺寸不正确");
+        }
+        auto* raw = static_cast<uint8_t*>(heap_caps_malloc(pixels, MALLOC_CAP_8BIT));
+        if (raw == nullptr) {
+            return std::unexpected("Out of memory for image pixels");
+        }
+        std::memcpy(raw, bytes + 10, pixels);
+        auto image = std::make_unique<LvglAllocatedImage>(
+            raw, pixels, w, h, w * 2, LV_COLOR_FORMAT_RGB565);
+        if (!display_->ShowFullscreenImage(std::move(image))) {
+            return std::unexpected("Display does not support fullscreen image");
+        }
+        return std::string("图片已全屏显示在设备屏幕上");
+    }
+
+    ToolResult ShowImageFromRaw(const std::string& encoded) {
+        if (display_ == nullptr) {
+            return std::unexpected("本设备没有可用的屏幕");
+        }
+        display_->HideFullscreenImage();
+        std::string bytes((encoded.size() * 3) / 4 + 4, '\0');
+        size_t out_len = 0;
+        if (mbedtls_base64_decode(reinterpret_cast<unsigned char*>(bytes.data()), bytes.size(),
+                                  &out_len, reinterpret_cast<const unsigned char*>(encoded.data()),
+                                  encoded.size()) != 0) {
+            return std::unexpected("图片数据无法解码");
+        }
+        return ShowRawImage(reinterpret_cast<const uint8_t*>(bytes.data()), out_len);
+    }
+
     void InitializeTools() {
         auto& mcp_server = McpServer::GetInstance();
         mcp_server.AddTool(
@@ -1073,6 +1131,32 @@ public:
                 }
                 return std::string("已开始播放音频");
             });
+
+        mcp_server.AddTool(
+            "self.screen.show_image",
+            "把一张图片显示在设备屏幕上。优先把 draw_picture 返回的 image_base64 "
+            "原样填入 data，设备直接显示，不再下载和解码。没有 data 时才使用 url。",
+            PropertyList({Property("data", kPropertyTypeString, std::string("")),
+                          Property("url", kPropertyTypeString, std::string(""))}),
+            [this](const PropertyList& properties) -> ToolResult {
+                const auto raw = properties["data"].value<std::string>();
+                if (!raw.empty()) {
+                    return ShowImageFromRaw(raw);
+                }
+                return std::unexpected("当前固件请使用 data 显示图片");
+            });
+
+        mcp_server.AddTool(
+            "self.screen.hide_image",
+            "关闭屏幕上的全屏图片，回到正常的对话界面。",
+            PropertyList(),
+            [this](const PropertyList&) -> ToolResult {
+                if (display_ == nullptr || !display_->IsFullscreenImageVisible()) {
+                    return std::string("屏幕当前没有全屏图片");
+                }
+                display_->HideFullscreenImage();
+                return std::string("已关闭全屏图片");
+            });
     }
 
     virtual AudioCodec* GetAudioCodec() override {
