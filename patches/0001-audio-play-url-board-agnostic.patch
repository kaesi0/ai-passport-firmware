index f3f4a68..277d972 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -1093,6 +1093,68 @@ void Application::ConfigureWakeWordForListening() {
 #endif
 }
 
+// ============================================================================
+// [本地补丁] 对话中主动播报音频（板级 MCP 工具 self.audio.play_url 的落点）
+//
+// 为什么不能直接调 StartNotification：
+//   1) 它的首行门禁是 `GetDeviceState() != kDeviceStateIdle -> return`（静默丢弃），
+//      而 MCP 工具被调用时设备必然处于 Listening/Speaking（用户刚说完话，服务端
+//      正在处理），因此请求 100% 被丢掉，且只留一行 ESP_LOGW。
+//   2) 状态机不允许 Listening/Speaking 直接转入 Notifying——它们只能回到 Idle
+//      （device_state_machine.cc:87-95：Listening -> Speaking|Idle，
+//       Speaking -> Listening|Idle；而 Notifying 只接受从 Idle 进入）。
+//      所以必须先显式回到 Idle，再交给 StartNotification 走 Idle -> Notifying。
+//
+// 两路声音不会打架：服务端推来的 TTS 音频包只在设备处于 kDeviceStateSpeaking 时
+// 才被投喂解码队列（application.cc:553-557）。设备一旦进入 Notifying，服务端的
+// 音频包会被直接丢弃；服务端随后的 tts start/stop 也只会命中 Speaking 分支而失效
+// （:624-637），不会打断播报。
+// ============================================================================
+bool Application::PlayAudioUrl(const std::string& url) {
+    if (url.empty()) {
+        ESP_LOGW(TAG, "PlayAudioUrl: refusing empty url");
+        return false;
+    }
+
+    // 本方法由 MCP 工具回调调用，而 McpServer 已用 Schedule 把回调派发到主任务
+    // （mcp_server.cc:615 "Use main thread to call the tool"），所以这里可以安全地
+    // 直接操作状态机与音频服务，无需再 Schedule 一次。
+    const auto state = GetDeviceState();
+
+    if (state == kDeviceStateNotifying) {
+        // 已在播报：先停掉旧的（StopNotification 内部会切回 Idle），再起新的
+        ESP_LOGI(TAG, "PlayAudioUrl: replacing notification in progress");
+        StopNotification();
+    } else if (state == kDeviceStateSpeaking) {
+        // 正在说话：先让服务端停止产出，避免"AI 还在说话就插播"的听感撕裂
+        AbortSpeaking(kAbortReasonNone);
+    } else if (state == kDeviceStateListening) {
+        // 正在听：关闭音频通道（与 WakeWordInvoke 在 Listening 下的处理一致）
+        if (protocol_) {
+            protocol_->CloseAudioChannel();
+        }
+    }
+
+    // 状态机要求：Notifying 只能从 Idle 进入，所以先回 Idle。
+    // Speaking -> Idle / Listening -> Idle 都是合法转换。
+    if (GetDeviceState() != kDeviceStateIdle) {
+        if (!SetDeviceState(kDeviceStateIdle)) {
+            ESP_LOGE(TAG, "PlayAudioUrl: cannot return to idle (state=%d)",
+                     static_cast<int>(GetDeviceState()));
+            return false;
+        }
+    }
+
+    StartNotification(url, {});
+
+    if (GetDeviceState() != kDeviceStateNotifying) {
+        ESP_LOGE(TAG, "PlayAudioUrl: playback did not start");
+        return false;
+    }
+    ESP_LOGI(TAG, "PlayAudioUrl: started, url=%s", url.c_str());
+    return true;
+}
+
 void Application::StartNotification(std::string audio_url, std::vector<NotifySubtitle> subtitles) {
     if (GetDeviceState() != kDeviceStateIdle || notify_player_.IsBusy()) {
         ESP_LOGW(TAG, "Ignoring notify message while device is busy");
