Subject: [PATCH] feat(audio): play story audio on the official speaking path

---
 main/application.cc | 38 ++++++++++++++++++++++++++++++++++++++
 main/application.h  | 17 +++++++++++++++++
 2 files changed, 55 insertions(+)

diff --git a/main/application.cc b/main/application.cc
index cfb1067..8c1cae4 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -1102,6 +1102,44 @@ void Application::ConfigureWakeWordForListening() {
 #endif
 }
 
+// ============================================================================
+// [本地补丁] 对话中主动播报音频（板级 MCP 工具 self.audio.play_url 的落点）
+//
+// 为什么不能直接调 StartNotification：
+//   1) 它的首行门禁是 `GetDeviceState() != kDeviceStateIdle -> return`（静默丢弃），
+//      而 MCP 工具被调用时设备必然处于 Listening/Speaking（用户刚说完话，服务端
+//      正在处理），因此请求 100% 被丢掉，且只留一行 ESP_LOGW。
+//   2) 状态机不允许 Listening/Speaking 直接转入 Notifying——它们只能回到 Idle
+//      （device_state_machine.cc:87-95：Listening -> Speaking|Idle，
+//       Speaking -> Listening|Idle；而 Notifying 只接受从 Idle 进入）。
+//      所以必须先显式回到 Idle，再交给 StartNotification 走 Idle -> Notifying。
+//
+// 两路声音不会打架：服务端推来的 TTS 音频包只在设备处于 kDeviceStateSpeaking 时
+// 才被投喂解码队列（application.cc:553-557）。设备一旦进入 Notifying，服务端的
+// 音频包会被直接丢弃；服务端随后的 tts start/stop 也只会命中 Speaking 分支而失效
+// （:624-637），不会打断播报。
+// ============================================================================
+bool Application::PlayAudioUrl(const std::string& url) {
+    if (url.empty()) {
+        ESP_LOGW(TAG, "PlayAudioUrl: refusing empty url");
+        return false;
+    }
+
+    // Official music stays on the speaking downlink. The separate notification
+    // downloader is what stops or reboots during a long story.
+    if (GetDeviceState() == kDeviceStateNotifying) {
+        StopNotification();
+    }
+    if (GetDeviceState() != kDeviceStateSpeaking &&
+        !SetDeviceState(kDeviceStateSpeaking)) {
+        ESP_LOGE(TAG, "PlayAudioUrl: cannot enter speaking");
+        return false;
+    }
+    audio_service_.ResetDecoder();
+    ESP_LOGI(TAG, "PlayAudioUrl: speaking path ready");
+    return true;
+}
+
 void Application::StartNotification(std::string audio_url, std::vector<NotifySubtitle> subtitles) {
     if (GetDeviceState() != kDeviceStateIdle || notify_player_.IsBusy()) {
         ESP_LOGW(TAG, "Ignoring notify message while device is busy");
diff --git a/main/application.h b/main/application.h
index f2b9a00..611478d 100644
--- a/main/application.h
+++ b/main/application.h
@@ -118,6 +118,23 @@ public:
     AecMode GetAecMode() const { return aec_mode_; }
     void PlaySound(const std::string_view& sound);
     AudioService& GetAudioService() { return audio_service_; }
+
+    /**
+     * [本地补丁] 播报一段网络音频（板级 MCP 工具 self.audio.play_url 的入口）
+     *
+     * 与 StartNotification 的差别：允许在对话过程中被调用——会先中断当前对话，
+     * 再进入播报态。直接调用 StartNotification 不行：MCP 工具被调用时设备必然
+     * 处于 Listening/Speaking，而它首行门禁要求 kDeviceStateIdle，会被静默丢弃；
+     * 且状态机不允许 Listening/Speaking 直接转入 Notifying。
+     *
+     * 约束（由固件决定，调用方需保证 URL 合规）：
+     *   - 单声道 Ogg Opus，采样率对齐本板 AUDIO_OUTPUT_SAMPLE_RATE（本板 16000）；
+     *   - 播报与对话共用同一条解码队列，播报期间无法对话；
+     *   - 播完自动回到 Idle，可用唤醒词中途打断（见 WakeWordInvoke）。
+     *
+     * @return true 表示已进入播报态（kDeviceStateNotifying）
+     */
+    bool PlayAudioUrl(const std::string& url);
     
