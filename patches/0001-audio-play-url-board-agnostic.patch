From 7dd3fd6bbba892116f4173bef5caf6b9fed4df43 Mon Sep 17 00:00:00 2001
From: kaesi0 <kaesi0@qq.com>
Date: Fri, 9 Oct 2026 21:57:04 +0800
Subject: [PATCH] feat(audio): play a network audio URL in the notification
 state

Adds Application::PlayAudioUrl(url) for the board MCP tool
self.audio.play_url. StartNotification cannot be called directly: its first
line requires kDeviceStateIdle, while an MCP tool call always arrives during
Listening/Speaking, and the state machine only lets Notifying be entered from
Idle. So PlayAudioUrl leaves the current state, returns to Idle, prepares the
codec/radio/WakeWord exactly like StartNotification, and then enters Notifying
itself.

Why Notifying and not Idle (fw-14 serial trace of the abort):

  20:36:32.007 StateMachine: State: idle -> speaking      <- cloud goodbye TTS
  20:36:32.008 HttpClient: Connection closed prematurely,
               expected 774638 bytes but only received 118200 bytes
  20:36:32.008 NotifyPlayer: Notification playback underrun #1 at 34180 ms

fw-11..fw-14 left the device in Idle but wrote every guard against
kDeviceStateNotifying, so none of them ever fired. The cloud's closing TTS
still reached the player, and entering kDeviceStateSpeaking runs
audio_service_.ResetDecoder() in HandleStateChangedEvent(): that bumps the
playback generation, the download task's next PushPacketToDecodeQueue() fails,
and it abandons the HTTP stream - playback stops as soon as the buffered audio
drains. Entering Notifying makes those guards effective.

OnIncomingAudio goes back to upstream's Speaking-only test: with the device
finally in Notifying, the `|| kDeviceStateNotifying` clause fw-11 added would
start feeding the cloud's TTS into the story's decode queue.

Cloud sentences are also no longer painted over the screen while Notifying.
The goodbye audio is already dropped, but showing its text made it look like
the story had been interrupted and replaced the announce line that belongs on
screen. The serial log still prints it.

Constraint from the firmware: mono Ogg Opus, logical packets <= 2048 bytes,
no redirects, 2xx only.
---
 main/application.cc | 121 +++++++++++++++++++++++++++++++++++++++++++-
 main/application.h  |  17 +++++++
 2 files changed, 137 insertions(+), 1 deletion(-)

diff --git a/main/application.cc b/main/application.cc
index 31de205..15355ee 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -570,6 +570,11 @@ void Application::InitializeProtocol() {
     protocol_->OnAudioChannelClosed([this, &board]() {
         board.SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
         Schedule([this]() {
+            // The cloud closes the conversation after its spoken reply. A story
+            // already playing must survive that; otherwise it stops immediately.
+            if (GetDeviceState() == kDeviceStateNotifying) {
+                return;
+            }
             auto display = Board::GetInstance().GetDisplay();
             display->SetChatMessage("system", "");
             SetDeviceState(kDeviceStateIdle);
@@ -623,6 +628,12 @@ void Application::InitializeProtocol() {
             }
             if (strcmp(state->valuestring, "start") == 0) {
                 Schedule([this]() {
+                    // A cloud goodbye arrives as another TTS turn. It must not
+                    // replace a story that is already playing.
+                    if (GetDeviceState() == kDeviceStateNotifying) {
+                        ESP_LOGI(TAG, "Ignoring cloud TTS while a story is playing");
+                        return;
+                    }
                     aborted_ = false;
                     SetDeviceState(kDeviceStateSpeaking);
                 });
@@ -645,8 +656,17 @@ void Application::InitializeProtocol() {
                         glyphs.clear();
                     }
                     ESP_LOGI(TAG, "<< %s", text->valuestring);
-                    Schedule([display, message = std::string(text->valuestring),
+                    // [本地补丁] 故事播放期间（Notifying）云端的句子一律不上屏。
+                    // 这时候云端来的都是会话收尾的道别（「好啦，那我就先不打扰你啦，拜拜！」），
+                    // 它的音频已经被丢弃、不会打断故事，但把文字盖到屏幕上会让人以为故事被它打断了，
+                    // 而且会把之前留在屏上的报幕文案顶掉。报幕走的是 Speaking，不受影响。
+                    // 串口仍然照原样留 `<< ` 一行，便于排查。
+                    Schedule([this, display, message = std::string(text->valuestring),
                               glyphs = std::move(glyphs), bpp]() {
+                        if (GetDeviceState() == kDeviceStateNotifying) {
+                            ESP_LOGI(TAG, "Keeping the story screen: cloud sentence not shown");
+                            return;
+                        }
                         display->AddTextGlyphs(glyphs, bpp);
                         display->SetChatMessage("assistant", message.c_str());
                     });
@@ -1098,6 +1118,105 @@ void Application::ConfigureWakeWordForListening() {
 #endif
 }
 
+// ============================================================================
+// [本地补丁] 对话中主动播报音频（板级 MCP 工具 self.audio.play_url 的落点）
+//
+// 为什么不能直接调 StartNotification：
+//   1) 它的首行门禁是 `GetDeviceState() != kDeviceStateIdle -> return`（静默丢弃），
+//      而 MCP 工具被调用时设备必然处于 Listening/Speaking（用户刚说完话，服务端
+//      正在处理），因此请求 100% 被丢掉，且只留一行 ESP_LOGW。
+//   2) 状态机不允许 Listening/Speaking 直接转入 Notifying——它们只能回到 Idle
+//      （device_state_machine.cc:87-95：Listening -> Speaking|Idle，
+//       Speaking -> Listening|Idle；而 Notifying 只接受从 Idle 进入）。
+//      所以先显式腾挪回 Idle，再自己走 Idle -> Notifying。
+//
+// ★ 故事必须真的进入 Notifying（2026-10-09 真机串口实测，链条每一环都有日志）：
+//   设备留在 Idle 时，云端会话收尾的那句道别会发 `tts start`，把设备切到 Speaking；
+//   而 `HandleStateChangedEvent()` 的 kDeviceStateSpeaking 分支会调用
+//   `audio_service_.ResetDecoder()`，解码队列代次一变，下载任务的下一次
+//   `PushPacketToDecodeQueue` 立刻返回 false → 下载任务放弃整条 HTTP 流：
+//
+//       20:36:32.007 StateMachine: State: idle -> speaking
+//       20:36:32.008 HttpClient: Connection closed prematurely,
+//                    expected 774638 bytes but only received 118200 bytes
+//       20:36:32.008 NotifyPlayer: Notification playback underrun #1 at 34180 ms
+//
+//   即「放到三十几秒，云端一道别就断」。以前几版把守卫写成 `state == Notifying`
+//   却没有一处真正切进 Notifying，所以那些守卫全是死代码（fw-11~fw-14 都如此）。
+//
+// 两路声音不会打架：服务端推来的 TTS 音频包只在设备处于 kDeviceStateSpeaking 时
+// 才被投喂解码队列（application.cc 的 OnIncomingAudio）。设备在 Notifying 时，
+// 服务端的音频包被直接丢弃；服务端的 tts start/stop 也命中不了 Speaking 分支
+// （被下面的守卫挡回），因此不会打断播报。
+// ============================================================================
+bool Application::PlayAudioUrl(const std::string& url) {
+    if (url.empty()) {
+        ESP_LOGW(TAG, "PlayAudioUrl: refusing empty url");
+        return false;
+    }
+    // Official music is protected from the cloud tts-stop message because it is
+    // not in the speaking state. A story must use that same notification state.
+    if (GetDeviceState() == kDeviceStateSpeaking) {
+        AbortSpeaking(kAbortReasonNone);
+    } else if (GetDeviceState() == kDeviceStateNotifying) {
+        StopNotification();
+    }
+    if (GetDeviceState() != kDeviceStateIdle &&
+        !SetDeviceState(kDeviceStateIdle)) {
+        ESP_LOGE(TAG, "PlayAudioUrl: cannot return to idle");
+        return false;
+    }
+
+    // 上一次播报的下载任务可能还在收尾（Stop() 只置位，worker 要跑完当前一轮才退），
+    // 而 NotifyPlayer::Start() 见到 worker_running_ 会直接返回 false。这里只等一个有界
+    // 的短时间，避免把主任务长时间占住；等不到就当作启动失败，让调用方看到明确结果。
+    if (notify_player_.IsBusy()) {
+        notify_player_.Stop();
+        for (int i = 0; i < 20 && notify_player_.IsBusy(); ++i) {
+            vTaskDelay(pdMS_TO_TICKS(10));
+        }
+        if (notify_player_.IsBusy()) {
+            ESP_LOGE(TAG, "PlayAudioUrl: previous playback is still winding down");
+            return false;
+        }
+    }
+
+    // 与 StartNotification 保持一致的准备动作：播报期间关掉语音处理、放开唤醒词资源，
+    // 射频抬到 PERFORMANCE。两块声音共用同一条解码队列，这里不做区分。
+    auto& board = Board::GetInstance();
+    board.SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    audio_service_.EnableVoiceProcessing(false);
+    audio_service_.EnableWakeWordDetection(audio_service_.IsAfeWakeWord());
+    audio_service_.ReleaseWakeWordResources();
+    while (audio_service_.PopPacketFromSendQueue()) {
+        // Discard microphone audio left over from a previous conversation.
+    }
+
+    if (!SetDeviceState(kDeviceStateNotifying)) {
+        ESP_LOGE(TAG, "PlayAudioUrl: cannot enter notifying");
+        board.SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
+        return false;
+    }
+
+    audio_service_.ResetDecoder();
+    uint32_t playback_id = ++notification_playback_id_;
+    if (playback_id == 0) {
+        playback_id = ++notification_playback_id_;
+    }
+    const bool started = notify_player_.Start(
+        url, {}, playback_id, nullptr,
+        [this](uint32_t id, bool success) {
+            Schedule([this, id, success]() { HandleNotificationFinished(id, success); });
+        });
+    if (!started) {
+        ESP_LOGE(TAG, "PlayAudioUrl: download did not start");
+        StopNotification();
+        return false;
+    }
+    ESP_LOGI(TAG, "PlayAudioUrl: queued on the notification decoder");
+    return true;
+}
+
 void Application::StartNotification(std::string audio_url, std::vector<NotifySubtitle> subtitles) {
     if (GetDeviceState() != kDeviceStateIdle || notify_player_.IsBusy()) {
         ESP_LOGW(TAG, "Ignoring notify message while device is busy");
diff --git a/main/application.h b/main/application.h
index f2b9a00..3458c69 100644
--- a/main/application.h
+++ b/main/application.h
@@ -118,6 +118,23 @@ public:
     AecMode GetAecMode() const { return aec_mode_; }
     void PlaySound(const std::string_view& sound);
     AudioService& GetAudioService() { return audio_service_; }
+
+    /**
+     * [本地补丁] 播报一段网络音频（板级 MCP 工具 self.audio.play_url 的入口）
+     *
+     * 与 StartNotification 的差别：允许在对话过程中被调用——会先中断当前对话，
+     * 再进入播报态。直接调用 StartNotification 不行：MCP 工具被调用时设备必然
+     * 处于 Listening/Speaking，而它首行门禁要求 kDeviceStateIdle，会被静默丢弃；
+     * 且状态机不允许 Listening/Speaking 直接转入 Notifying。
+     *
+     * 约束（由固件决定，调用方需保证 URL 合规）：
+     *   - 单声道 Ogg Opus，采样率对齐本板 AUDIO_OUTPUT_SAMPLE_RATE（本板 24000）；
+     *   - 播报与对话共用同一条解码队列，播报期间无法对话；
+     *   - 播完自动回到 Idle，可用唤醒词中途打断（见 WakeWordInvoke）。
+     *
+     * @return true 表示已进入说话态并开始下载
+     */
+    bool PlayAudioUrl(const std::string& url);
     
     /**
      * Reset protocol resources (thread-safe)
