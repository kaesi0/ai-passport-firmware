+    virtual bool ShowFullscreenImage(std::unique_ptr<LvglImage> image) override;
+    virtual void HideFullscreenImage() override;
+    virtual bool IsFullscreenImageVisible() const override { return fullscreen_active_; }
     virtual void SetupUI() override;
     // Add theme switching function
     virtual void SetTheme(Theme* theme) override;
