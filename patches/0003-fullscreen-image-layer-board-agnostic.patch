+// ============================================================================
+// [本地补丁] 全屏图片层实现
+//
+// 刻意放在两套消息样式（CONFIG_USE_WECHAT_MESSAGE_STYLE 的 #if / #else）之外：
+// 所有 LVGL 对象都挂在 lv_layer_top() 上，天然覆盖整个对话界面，
+// 因此改动与 UI 布局无关，两套样式共用同一份实现。
+//
+// 为什么不能直接用官方的 self.screen.preview_image：
+//   1) 它是 AddUserOnlyTool —— 模型在 tools/list 里看不到（除非服务端带
+//      withUserTools:true），于是典型症状是"模型念得出图片网址，屏幕却没反应"；
+//   2) 它 5 秒后自动消失（PREVIEW_IMAGE_DURATION_MS），且只占屏幕约一半，
+//      不适合"让用户仔细看一张图"。
+// 本层一直显示，直到显式调用 HideFullscreenImage()。
+// ============================================================================
+
+void LcdDisplay::DestroyFullscreenImageLocked() {
+    if (fullscreen_image_ != nullptr) {
+        // 删除对象会触发 LV_EVENT_DELETE，回调里 delete 掉持有的 LvglImage
+        // （其析构函数负责释放底层像素/压缩数据），所以这里只需删 LVGL 对象。
+        lv_obj_delete(fullscreen_image_);
+        fullscreen_image_ = nullptr;
+    }
+    fullscreen_active_ = false;
+}
+
+bool LcdDisplay::ShowFullscreenImage(std::unique_ptr<LvglImage> image) {
+    if (image == nullptr) {
+        return false;
+    }
+    const lv_img_dsc_t* dsc = image->image_dsc();
+    if (dsc == nullptr || dsc->header.w == 0 || dsc->header.h == 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: invalid image descriptor");
+        return false;
+    }
+    if (width_ <= 0 || height_ <= 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: display size unknown");
+        return false;
+    }
+    if (!setup_ui_called_) {
+        ESP_LOGW(TAG, "ShowFullscreenImage called before SetupUI()");
+    }
+
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return false;
+    }
+    // 同一时刻只保留一张全屏图：先清掉旧的，避免叠层泄漏。
+    DestroyFullscreenImageLocked();
+
+    lv_obj_t* obj = lv_image_create(lv_layer_top());
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_pad_all(obj, 0, 0);
+    lv_obj_set_style_border_width(obj, 0, 0);
+    lv_obj_set_style_outline_width(obj, 0, 0);
+    lv_obj_set_style_radius(obj, 0, 0);
+    // 浅色底：图片比例与屏幕不一致时，留白处不会透出底下的对话界面。
+    // 不用黑色。240x240 的图放到 240x320 屏幕上，黑色上下边会被看成「纯色图」。
+    lv_obj_set_style_bg_color(obj, lv_color_hex(0xF4EFE6), 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_pos(obj, 0, 0);
+    lv_obj_set_size(obj, width_, height_);
+
+    lv_image_set_src(obj, dsc);
+    // 保持原比例居中。STRETCH 会把正方形图拉成竖图。
+    lv_image_set_inner_align(obj, LV_IMAGE_ALIGN_CENTER);
+
+    // 所有权转交 LVGL 对象：对象被删除时释放 LvglImage。
+    LvglImage* raw_image = image.release();
+    lv_obj_add_event_cb(
+        obj,
+        [](lv_event_t* e) {
+            LvglImage* img = static_cast<LvglImage*>(lv_event_get_user_data(e));
+            if (img != nullptr) {
+                delete img;
+            }
+        },
+        LV_EVENT_DELETE, static_cast<void*>(raw_image));
+
+    fullscreen_image_ = obj;
+    fullscreen_active_ = true;
+    ESP_LOGI(TAG, "Fullscreen image shown: panel %dx%d, source %ldx%ld", width_, height_,
+             static_cast<long>(dsc->header.w), static_cast<long>(dsc->header.h));
+    return true;
+}
+
+void LcdDisplay::HideFullscreenImage() {
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return;
+    }
+    if (!fullscreen_active_ && fullscreen_image_ == nullptr) {
+        return;
+    }
+    DestroyFullscreenImageLocked();
+    ESP_LOGI(TAG, "Fullscreen image hidden");
+}
+
 void LcdDisplay::SetEmotion(const char* emotion) {
     if (!setup_ui_called_) {
         ESP_LOGW(TAG, "SetEmotion('%s') called before SetupUI() - emotion will not be displayed!",
diff --git a/main/display/lcd_display.h b/main/display/lcd_display.h
